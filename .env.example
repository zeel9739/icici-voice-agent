# ──────────────────────────────────────────────────────────────────────────────
# ICICI Prudential AMC — Voice Agent  |  ENVIRONMENT TEMPLATE
# Copy this file to backend/.env and fill in your credentials.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=ICICI Prudential Voice Agent
APP_VERSION=0.1.0

# ── Database ───────────────────────────────────────────────────────────────────
# Local development — SQLite (zero setup)
DATABASE_URL=sqlite+aiosqlite:///./data/icici_leads.db

# Production — PostgreSQL via Supabase (free at https://supabase.com)
# 1. Create a project at supabase.com
# 2. Go to Project Settings → Database → Connection String → URI
# 3. Replace "postgresql://" with "postgresql+asyncpg://"
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host]:5432/postgres

# ── LiveKit Cloud (https://cloud.livekit.io) ───────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Deepgram (https://console.deepgram.com) — STT ─────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Groq (https://console.groq.com) — LLM ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── Cartesia (https://play.cartesia.ai) — TTS ─────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key

# ── Agent tuning ───────────────────────────────────────────────────────────────
MIN_TRANSCRIPT_WORDS=1
MIN_TRANSCRIPT_CONFIDENCE=0.65
LLM_MODEL=llama-3.1-8b-instant
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# ──────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy to frontend/.env.local for local overrides (not needed in dev)
# Set on Vercel dashboard for production
# ──────────────────────────────────────────────────────────────────────────────

# In development this is NOT needed — Vite proxy handles /api/* → localhost:8000
# In production (Vercel) set this to your Render backend URL:
# VITE_API_URL=https://icici-api.onrender.com
VITE_API_URL=

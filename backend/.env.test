# ──────────────────────────────────────────────────────────────────────────────
# Test environment — used by `poetry run pytest`
# Uses in-memory SQLite so no real database or API keys are needed.
# The conftest.py overrides DATABASE_URL anyway, but these keep Settings happy.
# ──────────────────────────────────────────────────────────────────────────────

DEBUG=false

DATABASE_URL=sqlite+aiosqlite:///:memory:

LIVEKIT_URL=wss://test.livekit.local
LIVEKIT_API_KEY=test_api_key
LIVEKIT_API_SECRET=test_api_secret

DEEPGRAM_API_KEY=test_deepgram_key
GROQ_API_KEY=test_groq_key
CARTESIA_API_KEY=test_cartesia_key

MIN_TRANSCRIPT_WORDS=2
MIN_TRANSCRIPT_CONFIDENCE=0.65
LLM_MODEL=llama3-8b-8192
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22
